{
  // Static hosting for the admin panel, served at manage.maalbaan.com.
  "name": "maalbaan-admin",
  "routes": [{ "pattern": "manage.maalbaan.com", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Every address opens the app, so a refresh on /accounts/123 works.
    "not_found_handling": "single-page-application",
  },
}
