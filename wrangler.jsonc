{
  // Static hosting for the admin panel. Attach the custom domain manage.maalbaan.com in
  // Workers > maalbaan-admin > Settings > Domains & Routes.
  "name": "maalbaan-admin",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Every address opens the app, so a refresh on /accounts/123 works.
    "not_found_handling": "single-page-application",
  },
}
